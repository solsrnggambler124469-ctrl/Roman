func abs(n) {
    if (compare(n, 0, 2)) {
        return 0 - n;
    };
    return n;
};

func max(a, b) {
    if (compare(a, b, 1)) {
        return a;
    };
    return b;
};

func min(a, b) {
    if (compare(a, b, 2)) {
        return a;
    };
    return b;
};

func clamp(value, low, high) {
    return max(low, min(value, high));
};

# used while modulo system hasn't been developed yet #
func mod(a, b) {
    var remainder = a;
    while (compare(remainder, b, 3)) {
        remainder = remainder - b;
    };
    return remainder;
};

func isEven(n) {
    return compare(mod(n, 2), 0, 0);
};

func isOdd(n) {
    return compare(mod(n, 2), 0, 5);
};

# base raised to a non-negative integer exponent #
func pow(base, exponent) {
    var result = 1;
    var i = 0;
    while (compare(i, exponent, 2)) {
        result = result * base;
        i = i + 1;
    };
    return result;
};

# Newton's method -- converges to float precision well within 25 iterations #
func sqrt(n) {
    if (compare(n, 0, 2)) {
        print("sqrt: cannot compute square root of a negative number%n");
        return 0;
    };
    if (compare(n, 0, 0)) {
        return 0;
    };

    var guess = n;
    var i = 0;
    while (compare(i, 25, 2)) {
        guess = (guess + n / guess) / 2;
        i = i + 1;
    };
    return guess;
};

func factorial(n) {
    if (compare(n, 1, 4)) {
        return 1;
    };
    return n * factorial(n - 1);
};

# Euclidean algorithm #
func gcd(a, b) {
    if (compare(b, 0, 0)) {
        return a;
    };
    return gcd(b, mod(a, b));
};

func lcm(a, b) {
    return (a * b) / gcd(a, b);
};

# sum/average over a 1-indexed table of `size` numbers #
func sum(t, size) {
    var total = 0;
    var i = 1;
    while (compare(i, size, 4)) {
        total = total + table_get_index(t, i);
        i = i + 1;
    };
    return total;
};

func average(t, size) {
    return sum(t, size) / size;
};
