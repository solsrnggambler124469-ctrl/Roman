class Vector2 = {
    "x" : 0,
    "y" : 0
};

class Vector3 = {
    "x" : 0,
    "y" : 0,
    "z" : 0
};

func Vector2Add(v1, v2){
    Vector2 result;
    result > "x" = v1 > "x" + v2 > "x";
    result > "y" = v1 > "y" + v2 > "y";
    return result;
};

func Vector2Subtract(v1, v2){
    Vector2 result;
    result > "x" = v1 > "x" - v2 > "x";
    result > "y" = v1 > "y" - v2 > "y";
    return result;
};

func Vector2Multiply(v1, v2){
    Vector2 result;
    result > "x" = v1 > "x" * v2 > "x";
    result > "y" = v1 > "y" * v2 > "y";
    return result;
};

func Vector2Divide(v1, v2){
    Vector2 result;
    result > "x" = v1 > "x" / v2 > "x";
    result > "y" = v1 > "y" / v2 > "y";
    return result;
};

func Vector3Add(v1, v2){
    Vector3 result;
    result > "x" = v1 > "x" + v2 > "x";
    result > "y" = v1 > "y" + v2 > "y";
    result > "z" = v1 > "z" + v2 > "z";
    return result;
};

func Vector3Subtract(v1, v2){
    Vector3 result;
    result > "x" = v1 > "x" - v2 > "x";
    result > "y" = v1 > "y" - v2 > "y";
    result > "z" = v1 > "z" - v2 > "z";
    return result;
};

func Vector3Multiply(v1, v2){
    Vector3 result;
    result > "x" = v1 > "x" * v2 > "x";
    result > "y" = v1 > "y" * v2 > "y";
    result > "z" = v1 > "z" * v2 > "z";
    return result;
};

func Vector3Divide(v1, v2){
    Vector3 result;
    result > "x" = v1 > "x" / v2 > "x";
    result > "y" = v1 > "y" / v2 > "y";
    result > "z" = v1 > "z" / v2 > "z";
    return result;
};
