var x = 1;

for (x: ifcomp(x, 5, 5): "++") {
    print("'hello loop', has only been said", x, "times", "%n");
};

var s = 0;
var x = 0;

func add_on(add){
    var sdfg = s + add;
    return sdfg;
};

var x = add_on(5);
print(x, "%n");

print("xxx", "%n");

var b = 20;

print(b, "%n");

while (true) {
    print("hi", "%n");
    var b = b - 1;
};

print("e", "%n");
