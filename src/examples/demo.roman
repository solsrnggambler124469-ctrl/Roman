func add(a, b) {
    return a + b;
};

func greet(name) {
    return "Hello, " + name;
};

var x = 10;
var y = 5;
var sum = add(x, y);
var greeting = greet("world");

print("=== Roman Language Demo === %n");
print(greeting, "%n");
print(sum, "%n");

if (ifcomp(sum, 10, 1)) {
    print("sum is greater than 10%n");
};

ifelse (ifcomp(x, y, 1)) {
    print("x is greater than y %n");
} else {
    print("x is not greater than y %n");
};

table fruits = ["apple", "banana", "cherry"];
print(fruits, "%n");
print(table_get_index(fruits, 2), "%n");

var i = 1;
for (i : ifcomp(i, 5, 4) : "++") {
    print(i, "%n");
};

var count = 0;
while (ifcomp(count, 3, 2)) {
    print("counting up %n");
    var count = count + 1;
};

print(count, "%n");

print(type(x), "%n");
print(type("text"), "%n");
print(type(true), "%n");

class mammals {
    "__init" : func(){
        print("Mammals%n");
    },
    "man" : 1,
    "blood" : 2,
};

mammals>"init";
